# ==========================================
# RESCUE AI — Environment Variables
# ==========================================

# Moss Semantic Retrieval Credentials (Optional for Cloud; Local Fallback runs automatically)
MOSS_PROJECT_ID=your-moss-project-id
MOSS_PROJECT_KEY=your-moss-project-key

# LLM Reasoning Engine API Key
LLM_API_KEY=your-llm-api-key

# GitHub Integration (Optional; Demo GitHub Mode generates local branches & PR previews)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=acme-commerce
GITHUB_REPO=payment-service

# Database Connection (Defaults to SQLite rescue.db)
DATABASE_CONNECTION_STRING=Data Source=rescue.db
